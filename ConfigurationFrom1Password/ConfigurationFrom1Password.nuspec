<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2010/07/nuspec.xsd">
  <metadata>
    <id>ConfigurationFrom1Password</id>
    <version>1.0.0</version>
    <title>ConfigurationFrom1Password</title>
    <authors>Ken Bonny</authors>
    <description>A .NET configuration extension that securely loads secrets from 1Password into your application configuration without hardcoding credentials in your code. Intended for local development and testing scenarios. Requires the 1Password CLI (op.exe) to be installed and configured.</description>
    <summary>Load 1Password secrets into .NET configuration at runtime using the 1Password CLI.</summary>
    <projectUrl>https://github.com/KenBonny/ConfigurationFrom1Password</projectUrl>
    <repository type="git" url="https://github.com/KenBonny/ConfigurationFrom1Password" branch="master" />
    <license type="expression">MIT</license>
    <readme>README.md</readme>
    <tags>configuration 1password secrets dotnet aspnetcore console cli</tags>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <copyright>Copyright 2024 Ken Bonny</copyright>
    <repository type="git" url="https://github.com/KenBonny/ConfigurationFrom1Password.git" />
    <dependencies>
      <group targetFramework="net8.0">
        <dependency id="Microsoft.Extensions.Configuration" version="8.0.0" />
        <dependency id="Microsoft.Extensions.Configuration.Abstractions" version="8.0.0" />
      </group>
    </dependencies>
  </metadata>
  <files>
    <file src="bin\Release\net8.0\ConfigurationFrom1Password.dll" target="lib\net8.0\" />
    <file src="bin\Release\net8.0\ConfigurationFrom1Password.xml" target="lib\net8.0\" />
    <file src="..\README.md" target="\" />
  </files>
</package>
